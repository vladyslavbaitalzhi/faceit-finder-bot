# Обязательно: токен бота, полученный у @BotFather
BOT_TOKEN=

# Нужен для коротких ссылок /id/... и vanity-имён
STEAM_API_KEY=

# Нужен для запросов статистики Faceit Data API
FACEIT_API_KEY=

# Лимит запросов на пользователя: не более N действий за окно
RATE_LIMIT_REQUESTS=10
RATE_LIMIT_WINDOW_SECONDS=60

# Вес тяжёлых действий (сравнение, refresh); обычный поиск весит 1
RATE_LIMIT_HEAVY_WEIGHT=2

# Faceit: сколько HTTP-запросов можно выполнять одновременно
FACEIT_MAX_CONCURRENCY=5

# Проактивный лимит исходящих запросов Faceit в секунду (token bucket)
FACEIT_MAX_REQUESTS_PER_SECOND=4

# Глобальная пауза после 429, если Retry-After не задан
FACEIT_RATE_LIMIT_COOLDOWN_SECONDS=30

# Потолок глобальной паузы после 429 (даже если Retry-After больше)
FACEIT_RATE_LIMIT_COOLDOWN_MAX_SECONDS=300

# Максимум записей в TTL/LRU-кэше Faceit
FACEIT_CACHE_MAX_ENTRIES=2500

# Сколько секунд помнить 404 по поиску игрока
FACEIT_NEGATIVE_CACHE_TTL_SECONDS=60

# Cooldown кнопки «Обновить» для одного игрока
REFRESH_COOLDOWN_SECONDS=60
